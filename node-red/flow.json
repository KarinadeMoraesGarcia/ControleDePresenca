    {
        "id": "7e7b7396406f7cd7",
        "type": "function",
        "z": "ce7d95581325f2ed",
        "name": "Calcular Estatísticas",
        "func": "const rows = msg.payload || [];\n\nconst total = rows.length;\nconst presentes = rows.filter(r => r.status === 'Presente').length;\nconst ausentes = total > 0 ? (total - presentes) : 0;\n\n// O eCharts lê este array de objetos quando o eixo é Radial\nmsg.payload = [\n    { categoria: \"Presentes\", total: presentes },\n    { categoria: \"Ausentes\", total: ausentes }\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
