    {
        "id": "ef3c7c83fa9ad6ec",
        "type": "function",
        "z": "ce7d95581325f2ed",
        "name": "Montar Query Lista",
        "func": "msg.topic = \"SELECT a.ra, a.nome, IF(EXISTS (SELECT 1 FROM presenca p WHERE p.ra = a.ra AND DATE(p.datahora) = CURDATE()), 'Presente', 'Ausente') AS status FROM alunos a ORDER BY a.nome\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 560,
        "wires": [
