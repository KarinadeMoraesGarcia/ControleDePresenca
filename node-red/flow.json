    {
        "id": "7db2ba4bff44892f",
        "type": "function",
        "z": "ce7d95581325f2ed",
        "name": "Montar INSERT",
        "func": "msg.topic = \"INSERT INTO presenca (ra) VALUES (\" + Number(msg.ra) + \")\";\nreturn msg;",
