    {
        "id": "ac04cba4e7592718",
        "type": "function",
        "z": "ce7d95581325f2ed",
        "name": "Processar RA",
        "func": "if (!msg.payload || !msg.payload.ra || isNaN(Number(msg.payload.ra))) {\n    msg.statusCode = 400;\n    msg.payload = { erro: \"RA inválido\" };\n    return [null, msg];\n}\nmsg.ra = Number(msg.payload.ra);\nmsg.topic = \"SELECT * FROM alunos WHERE ra = \" + msg.ra;\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 260,
        "wires": [
